{{!
    @template local_coursegen/designer_chat_modal

    FP Euskadi Designer interactive chat modal.
    Full-screen chat interface for iterative design with LangGraph agents.

    Example context (json):
    {
        "courseid": 123
    }
}}
<div class="local_coursegen_designer_chat container-fluid h-100 d-flex flex-column" role="region"
     aria-label="{{#str}} designer_chat_arialabel, local_coursegen {{/str}}">

    <!-- Toolbar: design files and start over (the conversation is saved and resumed by default) -->
    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary" data-action="designer-toggle-files"
                    aria-expanded="false" aria-controls="designer-files-panel" disabled>
                <i class="fa fa-folder-open me-1" aria-hidden="true"></i>{{#str}} designer_files, local_coursegen {{/str}}
                <span class="badge bg-primary ms-1" data-region="designer-files-count">0</span>
            </button>
            <!-- Language of the conversation (and the course's AI language); names are endonyms -->
            <label class="sr-only" for="designer-language">{{#str}} designer_language, local_coursegen {{/str}}</label>
            <select id="designer-language" class="form-select form-select-sm w-auto" data-region="designer-language"
                    title="{{#str}} designer_language, local_coursegen {{/str}}" disabled>
                <option value="eu">Euskara</option>
                <option value="es">Español</option>
                <option value="en">English</option>
            </select>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="designer-new-conversation" disabled>
            <i class="fa fa-plus me-1" aria-hidden="true"></i>{{#str}} designer_new_conversation, local_coursegen {{/str}}
        </button>
    </div>

    <!-- Design files: download, edit offline, attach again to continue -->
    <div class="card mb-2" id="designer-files-panel" data-region="designer-files-panel" hidden>
        <div class="card-body py-2">
            <p class="small text-muted mb-2">{{#str}} designer_files_help, local_coursegen {{/str}}</p>
            <ul class="list-unstyled mb-0" data-region="designer-files-list"></ul>
            <p class="small text-muted mb-0" data-region="designer-files-empty">{{#str}} designer_files_none, local_coursegen {{/str}}</p>
        </div>
    </div>

    <!-- Chat messages area -->
    <div class="flex-grow-1 overflow-auto pb-3" id="designer-chat-messages"
         data-region="designer-chat-messages">
        <!-- Welcome message -->
        <div class="local_coursegen_ai_msg ai mb-3">
            <div class="d-flex align-items-start">
                <div class="designer-avatar me-2 flex-shrink-0">
                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 2rem; height: 2rem;">
                        <i class="fa fa-graduation-cap text-white" style="font-size: 0.9rem;"></i>
                    </div>
                </div>
                <div class="bubble bg-light rounded p-3 flex-grow-1">
                    <div id="designer-ai-response" data-region="designer-ai-response">
                        <div class="d-flex align-items-center text-muted">
                            <div class="spinner-border spinner-border-sm me-2" role="status">
                                <span class="sr-only">{{#str}} course_streaming_loading, local_coursegen {{/str}}</span>
                            </div>
                            <small>{{#str}} designer_chat_connecting, local_coursegen {{/str}}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Phase progress indicator (hidden by default) -->
    <div id="designer-phase-indicator" class="mb-2" style="display: none;">
        <div class="card bg-light border-0">
            <div class="card-body py-2">
                <div class="d-flex align-items-center">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status">
                        <span class="sr-only">{{#str}} course_streaming_loading, local_coursegen {{/str}}</span>
                    </div>
                    <small id="designer-phase-text" class="text-muted">
                        {{#str}} designer_chat_designing, local_coursegen {{/str}}
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Chat input area (always visible) -->
    <div class="border-top pt-3" id="designer-chat-input-area">
        <form id="designer-chat-form">
            <!-- Attachments waiting to be sent with the next message -->
            <div class="d-flex flex-wrap gap-2 mb-2" data-region="designer-attachments" aria-live="polite"></div>
            <label class="sr-only" for="designerChatInput">{{#str}} enter_message, local_coursegen {{/str}}</label>
            <div class="local_coursegen_ai_input_group">
                <input type="file" class="d-none" id="designer-attach-input" data-region="designer-attach-input" multiple
                       accept=".pdf,.docx,.xlsx,.txt,.md,.markdown,.csv,.json,.html,.htm">
                <button class="local_coursegen_ai_attach" type="button" data-action="designer-attach"
                        title="{{#str}} designer_attach, local_coursegen {{/str}} — {{#str}} designer_attach_help, local_coursegen {{/str}}"
                        aria-label="{{#str}} designer_attach, local_coursegen {{/str}}">
                    <i class="fa fa-paperclip" aria-hidden="true"></i>
                </button>
                <textarea id="designerChatInput" class="form-control local_coursegen_ai_textarea" rows="2"
                    placeholder="{{#str}} designer_chat_placeholder, local_coursegen {{/str}}"></textarea>
                <button class="local_coursegen_ai_send" type="button"
                        title="{{#str}} send, local_coursegen {{/str}}" id="designer-send-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                        <path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</div>

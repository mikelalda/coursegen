{{!
    @template local_coursegen/activity_chat_footer

    Activity Chat Footer Template

    Template for the chat interface that appears in the modal footer.
    Contains form for activity AI generation with image options.

    Example context (json):
    {
        "activityname": "Discussion Forum",
        "sectionname": "Week 1",
        "languages": [
            {"code": "es", "name": "Spanish (es)", "selected": true},
            {"code": "eu", "name": "Basque (eu)", "selected": false}
        ]
    }
}}
<div class="col-lg-10">
    <div id="activity-chat-interface" class="py-3 w-100">
    <form class="local_coursegen_ai_input" novalidate>
        
        <!-- Selector de idioma del contenido generado -->
        <div class="mb-3">
            <label class="form-label small text-muted mb-1" for="activity-lang-selector">
                {{#str}} ai_response_language, local_coursegen {{/str}}
            </label>
            <select name="activity_lang" class="form-control form-control-sm" id="activity-lang-selector">
                {{#languages}}
                <option value="{{code}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/languages}}
            </select>
        </div>

        <!-- Selector de tipo de actividad -->
        <div class="mb-3">
            <label class="form-label small text-muted mb-1">
                {{#str}} selectactivitytype, local_coursegen {{/str}}
            </label>
            <select name="activity_type" class="form-control form-control-sm" id="activity-type-selector">
                <option value="auto" selected>{{#str}} activitytype_auto, local_coursegen {{/str}}</option>
                <optgroup label="{{#str}} activitytype_content, local_coursegen {{/str}}">
                    <option value="page">{{#str}} activitytype_page, local_coursegen {{/str}}</option>
                    <option value="book">{{#str}} activitytype_book, local_coursegen {{/str}}</option>
                    <option value="lesson">{{#str}} activitytype_lesson, local_coursegen {{/str}}</option>
                    <option value="resource">{{#str}} activitytype_resource, local_coursegen {{/str}}</option>
                    <option value="url">{{#str}} activitytype_url, local_coursegen {{/str}}</option>
                    <option value="label">{{#str}} activitytype_label, local_coursegen {{/str}}</option>
                </optgroup>
                <optgroup label="{{#str}} activitytype_interactive, local_coursegen {{/str}}">
                    <option value="h5pactivity">{{#str}} activitytype_h5p, local_coursegen {{/str}}</option>
                    <option value="scorm">{{#str}} activitytype_scorm, local_coursegen {{/str}}</option>
                </optgroup>
                <optgroup label="{{#str}} activitytype_assessment, local_coursegen {{/str}}">
                    <option value="quiz">{{#str}} activitytype_quiz, local_coursegen {{/str}}</option>
                    <option value="assign">{{#str}} activitytype_assignment, local_coursegen {{/str}}</option>
                    <option value="feedback">{{#str}} activitytype_feedback, local_coursegen {{/str}}</option>
                </optgroup>
                <optgroup label="{{#str}} activitytype_collaboration, local_coursegen {{/str}}">
                    <option value="forum">{{#str}} activitytype_forum, local_coursegen {{/str}}</option>
                    <option value="wiki">{{#str}} activitytype_wiki, local_coursegen {{/str}}</option>
                    <option value="glossary">{{#str}} activitytype_glossary, local_coursegen {{/str}}</option>
                </optgroup>
            </select>
        </div>

        <!-- Radios de imágenes -->
        <div style="gap: .8rem;" class="mb-2 d-flex align-items-center">
            <label style="gap: .3rem;" class="mb-0 d-flex align-items-center">
                <input type="radio" name="generate_images" value="0" checked>
                {{#str}} noimages, local_coursegen {{/str}}
            </label>
            <label style="gap: .3rem;" class="mb-0 d-flex align-items-center">
                <input type="radio" name="generate_images" value="1">
                {{#str}} yesimages, local_coursegen {{/str}}
            </label>
        </div>

        <!-- Input de texto y botón -->
        <label class="sr-only" for="bdaiPrompt">{{#str}} addactivityai_label, local_coursegen {{/str}}</label>
        <div class="local_coursegen_ai_input_group">
            <textarea id="bdaiPrompt" class="form-control local_coursegen_ai_textarea" rows="2"
                placeholder="{{#str}} addactivityai_placeholder, local_coursegen {{/str}}" required></textarea>

            <button class="local_coursegen_ai_send" type="submit" title="{{#str}} send, local_coursegen {{/str}}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/>
                </svg>
            </button>
        </div>
    </form>
    </div>
    <div class="w-100 text-center mt-2" aria-label="Powered by BirtAI">
        <small class="text-muted">
            Powered by
            <a href="https://birtai.com/" target="_blank" rel="noopener">
                BirtAI
            </a>
        </small>
    </div>
</div>
